# Obtén estos valores desde Supabase: Project Settings > API
SUPABASE_URL=https://tu-project-ref.supabase.co
SUPABASE_ANON_KEY=tu-clave-anon-publica

# Obligatoria para los endpoints administrativos de usuarios y para crear técnicos.
# Nunca la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# Cadena de conexión PostgreSQL de Supabase para transacciones desde la API.
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:tu-password@db.[project-ref].supabase.co:5432/postgres

PORT=3000
